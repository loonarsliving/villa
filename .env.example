# ─────────────────────────────────────────────────────────────
# Loonars Villa — Environment Variables
# Copy to .env.local for development. In production these are set in the
# Vercel project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────

# Public — used by src/lib/supabaseAdmin.ts as the project URL. The rest of
# the app talks to villa-api (an external Supabase Edge Function) directly
# via its hardcoded URL in src/lib/api.ts, so this is only needed by the
# AI CCTV module below.
NEXT_PUBLIC_SUPABASE_URL=https://svcmybsziaelwwdrnzcv.supabase.co

# Server-only. Needed by the AI CCTV module's own API routes
# (src/app/api/cctv/*, src/app/api/cron/cctv-checkpoint) to read/write
# cctv_cameras / cctv_checkpoint_log directly — this module does not go
# through villa-api. Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# AI CCTV module (src/lib/cctvCheckpoint.ts)
# ─────────────────────────────────────────────────────────────

# Protects /api/cron/cctv-checkpoint. Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when it triggers a scheduled Cron Job
# (see vercel.json `crons`), so no extra wiring is needed beyond setting the
# same value here.
CRON_SECRET=

# Restricts the /admin/cctv dashboard and its API routes to a single admin
# account (Avianto Perdana). Defaults to his known villa_users.id if unset
# — see src/lib/cctvGuard.ts / src/lib/cctvConstants.ts. Only needs to be
# set if that account is ever recreated with a new id.
CCTV_ALLOWED_USER_ID=

# EZVIZ Open Platform (open.ezvizlife.com) — cloud path, since the cameras
# are reached over the internet rather than a shared LAN with this server.
# Register a developer account there to get these (account-level, not
# per-camera). Per-camera serial number + verification code are entered in
# the /admin/cctv dashboard itself, not here.
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
# Only override if using the China-region platform instead:
# EZVIZ_API_BASE=https://open.ys7.com

# Google AI Studio API key — used for Gemini Vision presence detection on
# each checkpoint snapshot (src/lib/gemini.ts). Same variable name as
# Mkhsistem's GEMINI_API_KEY, but this is villa's own Vercel project, so it
# must be set here separately.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_MAX_ATTEMPTS=3
