# Copy to .env.local for local dev, or set these in Vercel project env vars.
# No real values belong in this file or anywhere in the repo.

# Inbound Cloudbeds webhook (src/app/api/webhooks/cloudbeds/route.ts).
# Shared secret Cloudbeds must send back in the x-cloudbeds-secret header.
CLOUDBEDS_WEBHOOK_SECRET=

# Supabase service-role key, used by the webhook route to write directly to
# Postgres (bypasses RLS). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Outbound Cloudbeds API (src/lib/cloudbedsApi.ts), used by
# /api/admin/cloudbeds/rooms to power the live room picker on the
# admin Cloudbeds mapping page. Self-service, property-level API key from
# Cloudbeds: Account > Apps & Marketplace > API Credentials > Create.
CLOUDBEDS_API_KEY=

# Only needed if CLOUDBEDS_API_KEY is scoped to a group/multi-property
# account rather than a single property. Leave blank otherwise.
CLOUDBEDS_PROPERTY_ID=

# Outbound iPaymu API (src/lib/ipaymuApi.ts), used by /api/payment-gateway/qris
# and /api/payment-gateway/qris/status to generate real dynamic QRIS for
# Payment Gateway transactions (cafe/spa/lainnya + villa walk-in booking) and
# to confirm payment status server-to-server. From your iPaymu dashboard.
IPAYMU_VA=
IPAYMU_API_KEY=

# "sandbox" (default) or "production". Only set to "production" once tested
# end-to-end against the sandbox -- the response shape from iPaymu's
# /payment/direct wasn't verifiable from this dev environment (their docs
# site was unreachable), so src/lib/ipaymuApi.ts parses it defensively.
# Test on sandbox first and confirm the QRIS actually renders before flipping.
IPAYMU_ENV=sandbox

# EZVIZ Open Platform (open.ezvizlife.com), used by src/lib/ezviz.ts +
# /api/cctv/token to power the admin-only CCTV live-view page
# (admin/cctv/page.tsx, EZUIKit web player). Account-level -- create at
# open.ezvizlife.com, developer console.
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
# Only override if the account is on the China-region platform instead:
# EZVIZ_API_BASE=https://open.ys7.com
